# Copy this file to .env and fill in your values
# The .env file is git-ignored and never committed

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---
# Server port (default: 6363)
CLAUSE_EXTRACTOR_PORT=6363

# Claude model to use for extraction (default: claude-sonnet-4-5-20250929)
# Cheaper/faster alternative: claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-5-20250929
